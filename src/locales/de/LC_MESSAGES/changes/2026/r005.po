#: ../../../src/changes/2026/r005.md:6
msgid "Release 2026_005 (2026-02-09)"
msgstr ""

#: ../../../src/changes/2026/r005.md:8
msgid "Impact"
msgstr ""

#: ../../../src/changes/2026/r005.md:10
msgid "25.05"
msgstr ""

#: ../../../src/changes/2026/r005.md:12
msgid "more packages are built locally in the VM"
msgstr ""

#: ../../../src/changes/2026/r005.md:14
msgid ""
"Many packages cached before on cache.nixos.org cannot be pulled from "
"there anymore, due cascading rebuilds caused by base package updates. All"
" core roles and important packages are still pre-built by FlyingCircus, "
"but VMs using less common packages might now need to build them locally. "
"This can increase load on the machines **already ahead of the update**, "
"when the update is prepared."
msgstr ""

#: ../../../src/changes/2026/r005.md:17
msgid "most services will be restarted due to core dependency changes"
msgstr ""

#: ../../../src/changes/2026/r005.md:20
msgid "25.11"
msgstr ""

#: ../../../src/changes/2026/r005.md:22
msgid "Machines will reboot to activate a changed kernel."
msgstr ""

#: ../../../src/changes/2026/r005.md:25
msgid "NixOS 25.05 platform"
msgstr ""

#: ../../../src/changes/2026/r005.md:27
msgid ""
"haproxy: switch default TLS backend to `openssl`, as `quictls` "
"development is abandoned and has known vulnerabilities."
msgstr ""

#: ../../../src/changes/2026/r005.md:29
msgid "grub: apply patches to make boots from XFS more resilient (PL-135139)"
msgstr ""

#: ../../../src/changes/2026/r005.md:31 ../../../src/changes/2026/r005.md:77
msgid ""
"Improve logging and instrospection of kernel messages in early boot "
"(PL-135139)"
msgstr ""

